# AnswerForge Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Database Connection (SQL Server)
DATABASE_URL=server=sql02.edvistas.local,51433;database=AnswerForge;uid=webapp;pwd=your-password;Connection Timeout=150;max pool size=200

# AI Provider (Optional - OpenRouter for Claude/GPT access)
OPENROUTER_API_KEY=your-openrouter-api-key

# Application Settings
APP_NAME=AnswerForge
APP_VERSION=0.1.0
DEBUG=true

# CORS (comma-separated list for production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
